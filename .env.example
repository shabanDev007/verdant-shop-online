# API configuration — copy to .env and adjust per environment.
# Frontend reads via import.meta.env.VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase public browser credentials (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Set to true only after deploying and testing the create-order Edge Function.
VITE_ENABLE_LIVE_ORDERS=false

# Keep true while developing with sample products. Set false in production.
VITE_USE_MOCK_DATA=true
